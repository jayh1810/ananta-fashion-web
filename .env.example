# Local
PORT=3000
# Local — use localhost when testing on this machine only.
# For phone/LAN testing at http://192.168.x.x:3000, localhost below is OK:
# getApiUrl() auto-rewrites to http://192.168.x.x:3003 when opened from LAN.
NEXT_PUBLIC_API_URL=http://localhost:3003/api/v1
NEXT_PUBLIC_BRAND=Ananta Fashion
# Meta (Facebook) Pixel — paste your Pixel ID from Facebook Events Manager (public ID, not a secret)
NEXT_PUBLIC_META_PIXEL_ID=
# Google Analytics 4 Measurement ID (Admin → Data streams → Web)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google reCAPTCHA v3 — site key only (never put the secret here)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Canonical storefront URL used by sitemap, robots.txt, and Open Graph
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shipment tracking site (served by the admin app's /tracking route)
# NEXT_PUBLIC_TRACKING_URL=http://localhost:3001
# Shared secret — API calls POST /api/revalidate/catalog after admin catalog/homepage changes
# REVALIDATION_SECRET=generate-a-long-random-secret

# ─── Production (Coolify web / anantafashion.com) ─────────────────
# Set BEFORE npm run build:
# NEXT_PUBLIC_API_URL=https://api.anantafashion.com/api/v1
# NEXT_PUBLIC_BRAND=Ananta Fashion
# NEXT_PUBLIC_API_HOST=api.anantafashion.com
# NEXT_PUBLIC_SITE_URL=https://anantafashion.com
# NEXT_PUBLIC_TRACKING_URL=https://track.anantafashion.com
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# REVALIDATION_SECRET=generate-a-long-random-secret-matching-api
